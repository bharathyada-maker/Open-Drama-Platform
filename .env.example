# OpenDrama Environment Variables Example
# Copy this file to .env or .env.local inside your apps/web/ directory to configure local keys.

# Supabase Project Connection Details
# Leave empty to run in Local Database Fallback mode (localStorage engine)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API Key
# Add your Google AI Studio API key here to enable live video metadata suggestions
VITE_GEMINI_API_KEY=your_gemini_api_key_here
